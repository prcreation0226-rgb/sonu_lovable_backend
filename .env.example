# ==========================================
# Radiantilyk Aesthetic EMR — Environment Variables
# ==========================================
# COPY THIS FILE TO .env AND FILL IN REAL VALUES
# NEVER COMMIT .env TO VERSION CONTROL

# ---- SERVER ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---- DATABASE (MySQL 8.0) ----
DATABASE_URL="mysql://root:your_password@localhost:3306/radiantilyk_emr"

# ---- REDIS ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# ---- JWT AUTHENTICATION ----
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
REFRESH_TOKEN_HMAC_SECRET=CHANGE_ME_hmac_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- ENCRYPTION (AES-256-GCM for MFA secrets, sensitive columns) ----
ENCRYPTION_KEY=CHANGE_ME_exactly_32_bytes_hex_64_chars

# ---- AWS S3 (Encrypted PHI Storage) ----
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=radiantilyk-emr-phi
S3_PRESIGNED_EXPIRY_SECONDS=900

# ---- STRIPE (PCI-DSS L1 — No PHI in metadata) ----
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_TERMINAL_LOCATION=

# ---- EMAIL (BAA-Covered — AWS SES or Resend) ----
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@bookrka.com

# ---- SMS (BAA-Covered — Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- RATE LIMITING ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- LOGGING ----
LOG_LEVEL=debug
LOG_FILE_PATH=./logs
